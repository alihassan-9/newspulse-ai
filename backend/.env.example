# Copy to .env and adjust as needed.

# How often the newsroom pulls fresh news (seconds). 300 = every 5 minutes.
REFRESH_INTERVAL=300

# Per-feed HTTP timeout (seconds).
FETCH_TIMEOUT=8

# Comma-separated origins allowed to call this API (the Next.js app).
CORS_ORIGINS=http://localhost:3000

# AI Journalist LLM brain: "ollama" (local, free, no key) or "gemini" (cloud).
LLM_PROVIDER=gemini
# Local model via Ollama (https://ollama.com). Pull one first, e.g. `ollama pull llama3.2`.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: enables the AI Journalist research briefs (Google Gemini).
# Free key from https://aistudio.google.com  (requires available quota).
# Also used by Nano Banana post images (Gemini 2.5 Flash Image) regardless of LLM_PROVIDER.
GEMINI_API_KEY=
