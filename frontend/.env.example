# Copy to .env.local and fill in. (.env.local is gitignored, never committed.)

# Google Gemini API key — free from https://aistudio.google.com ("Get API key").
# Used by Nano Banana (Gemini 2.5 Flash Image) to invent a background for
# stories that have no photo. Posts for stories WITH a photo work without it.
GEMINI_API_KEY=

# FastAPI backend URL. When set, the app reads live news from the Python
# newsroom (agents) and falls back to built-in ingestion if it is unreachable.
# Leave empty to run the frontend standalone.
BACKEND_URL=http://localhost:8000
